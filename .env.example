# =============================================================================
# Observatorio Tecnologico Industrial — Variables de Entorno
# =============================================================================
# Copiar este archivo como backend/.env y ajustar segun entorno:
#   cp .env.example backend/.env
# =============================================================================

# -- Base de datos (SQLite) ----------------------------------------------------
DATABASE_URL=sqlite+aiosqlite:///./observatorio.db

# -- Neo4j --------------------------------------------------------------------
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=observatorio_dev

# -- Redis --------------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# -- JWT -----------------------------------------------------------------------
SECRET_KEY=change-me-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# -- CORS ---------------------------------------------------------------------
BACKEND_CORS_ORIGINS=["http://localhost:5173"]

# -- Superusuario inicial -----------------------------------------------------
FIRST_SUPERUSER=admin@mindus.gob.cu
FIRST_SUPERUSER_PASSWORD=change-me-in-production

# -- Frontend URL --------------------------------------------------------------
FRONTEND_URL=http://localhost:5173

# -- SMTP (email notifications) -----------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=True
EMAIL_FROM=Observatorio Tecnologico Industrial <noreply@mindus.gob.cu>

# -- Uploads ------------------------------------------------------------------
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE=10485760
ALLOWED_EXTENSIONS=.pdf,.doc,.docx,.xls,.xlsx,.png,.jpg,.jpeg
